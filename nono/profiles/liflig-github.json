                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customer-portal-webapp"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customer-portal-webapp/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-customer-register"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-customer-register/**"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customer-register"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customer-register/**"
                      },
                      {
                        "method": "GET",
