                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-customs-no/**"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customs-no"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-customs-no/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-customs-se"
