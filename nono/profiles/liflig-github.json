{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "liflig-github",
    "description": "Generated by nono/tools/gen-github.py from nono/github-repos.txt: gh reads the listed private repositories, read-only."
  },
  "command_policies": {
    "credentials": {
      "github-private-gh": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "credential_key": "github_pat",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "token {}"
      }
    },
    "commands": {
      "gh": {
        "from": {
          "session": {
            "sandbox": {
              "environment": {
                "allow_vars": [
                  "HOME",
                  "USER",
                  "LOGNAME",
                  "TERM",
                  "COLORTERM",
                  "LANG",
                  "LC_*",
                  "TZ",
                  "TMPDIR",
                  "NO_COLOR",
                  "CLICOLOR*",
                  "PAGER",
                  "GH_PAGER",
                  "GH_FORCE_TTY",
                  "GH_PROMPT_DISABLED",
                  "GH_NO_UPDATE_NOTIFIER",
                  "GH_SPINNER_DISABLED",
                  "SSL_CERT_FILE",
                  "SSL_CERT_DIR",
                  "GIT_*",
                  "XDG_*",
                  "MISE_*"
                ]
              },
              "credentials": [
                {
                  "name": "github-private-gh",
                  "endpoint_policy": {
                    "default": {
                      "decision": "deny"
                    },
                    "allow": [
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-booking-facade"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-booking-facade/**"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-booking-facade"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-booking-facade/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-booking-service"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-booking-service/**"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-booking-service"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-booking-service/**"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-cargodesk-webapp"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-cargodesk-webapp/**"
                      },
                      {
                        "method": "HEAD",
                        "path": "/repos/nsbno/cn-cx-cargodesk-webapp"
                      },
                      {
                        "method": "HEAD",
