              ]
            },
            "invocation_policy": {
              "default": {
                "decision": "deny"
              },
              "deny": [
                {
                  "argv": {
                    "contains": [
                      "-R"
                    ]
                  },
                  "reason": "gh resolves the repository from the working directory"
                },
                {
                  "argv": {
                    "contains": [
                      "--repo"
                    ]
                  },
                  "reason": "gh resolves the repository from the working directory"
                }
              ],
              "allow": [
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "list"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "view"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "diff"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "checks"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "pr",
                      "status"
                    ]
                  }
                },
                {
                  "argv": {
                    "prefix": [
                      "issue",
                      "list"
                    ]
                  }
                },
                {
