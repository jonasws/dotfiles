                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-consignment-service"
                      },
                      {
                        "method": "GET",
                        "path": "/repos/nsbno/cn-cx-consignment-service/**"
                      },
                      {
