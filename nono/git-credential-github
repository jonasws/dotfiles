#!/bin/sh
# git credential helper for agents in nono. GITHUB_GIT_TOKEN is the
# placeholder of the github.com route in liflig-base; nono swaps it for the
# real token on the host, so the real one never reaches the sandbox. gh is no
# use here: it is a mediated command whose GH_TOKEN belongs to api.github.com.
[ "$1" = get ] || exit 0
[ -n "${GITHUB_GIT_TOKEN:-}" ] || exit 0
echo username=x-access-token
echo "password=$GITHUB_GIT_TOKEN"
