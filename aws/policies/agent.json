{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeveloperMinusEscalationSecretsAndDeletes",
      "Effect": "Allow",
      "Resource": "*",
      "NotAction": [
        "account:*", "organizations:*",
        "sts:AssumeRole*", "sts:GetFederationToken", "sts:GetSessionToken",
        "iam:Add*", "iam:Attach*", "iam:Create*", "iam:Delete*", "iam:Detach*",
        "iam:PassRole", "iam:Put*", "iam:Remove*", "iam:Set*", "iam:Update*", "iam:Upload*",
        "secretsmanager:GetSecretValue", "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter*",
        "ec2:GetPasswordData", "ecr:GetAuthorizationToken",
        "cloudformation:DeleteStack",
        "cloudtrail:Delete*", "cloudtrail:StopLogging",
        "dynamodb:DeleteBackup", "dynamodb:DeleteTable",
        "ec2:Delete*", "ec2:TerminateInstances",
        "ecr:BatchDeleteImage", "ecr:DeleteRepository",
        "ecs:DeleteCluster", "ecs:DeleteService",
        "kms:DisableKey", "kms:ScheduleKeyDeletion",
        "lambda:DeleteFunction",
        "logs:DeleteLogGroup",
        "rds:DeleteDB*",
        "route53:DeleteHostedZone",
        "s3:DeleteBucket*", "s3:DeleteObject*", "s3:PutBucketPolicy"
      ]
    }
  ]
}
