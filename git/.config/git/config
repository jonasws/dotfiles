# Stow package: git
#
# Kept here rather than in ~/.gitconfig so it stays version-controlled. Git
# reads this file in addition to ~/.gitconfig; ~/.gitconfig wins on conflicts,
# so nothing here overrides settings already there.
#
# templateDir seeds .git/hooks at clone and init time. Existing repos need the
# hook copied in once; see README.
#
# Deliberately not core.hooksPath. That shadows .git/hooks for every repo, and
# pre-commit refuses to install while it is set:
#   [ERROR] Cowardly refusing to install hooks with `core.hooksPath` set.
[init]
	templateDir = ~/.config/git/template
