#!/usr/bin/env bash
# credential_process that hands out a profile's temporary credentials narrowed
# by STS GetScopedCredentials. The identity stays the parent's; permissions are
# the intersection of the parent session and each --policy, applied in order as
# separate scope-down layers (at most 3, and every layer but the last must allow
# sts:GetScopedCredentials). Expiry is the parent's unless --duration shortens it.
#
#   credential_process=aws-scoped-credentials --profile cnops-dev-developer --policy readonly --description aws-mcp-readonly
#
# --policy takes a path or a name in ~/.aws/policies (readonly -> readonly.json).
# Needs aws-cli >= 2.41.2 and sts:GetScopedCredentials on the parent. The API is
# not on the global STS endpoint, so the parent profile's region is used.
# Written for bash 3.2: credential_process may run it outside Homebrew's PATH.
set -euo pipefail

die() { echo "aws-scoped-credentials: $*" >&2; exit 1; }

parent="" description="" duration="" policies=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) parent="${2:?}"; shift 2 ;;
    --policy) policies="$policies${policies:+
}${2:?}"; shift 2 ;;
    --description) description="${2:?}"; shift 2 ;;
    --duration) duration="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$parent" ] || die "--profile is required"
[ -n "$policies" ] || die "at least one --policy is required"

region="$(aws configure get region --profile "$parent" || true)"
region="${region:-${AWS_REGION:-eu-west-1}}"

creds="$(aws configure export-credentials --profile "$parent" --format process)" \
  || die "could not resolve credentials for profile $parent"

while IFS= read -r policy; do
  case "$policy" in
    */*) file="$policy" ;;
    *) file="$HOME/.aws/policies/$policy.json" ;;
  esac
  [ -r "$file" ] || die "policy not found: $file"
  doc="$(jq -c . "$file")" || die "policy is not valid JSON: $file"
  [ "${#doc}" -le 2048 ] || die "policy is ${#doc} characters minified, over the 2048 limit: $file"

  set -- --policy "$doc"
  [ -z "$duration" ] || set -- "$@" --duration-seconds "$duration"
  [ -z "$description" ] || set -- "$@" --scoped-session-description "$description"

  # Env credentials only: a profile in the environment must not win over them.
  out="$(env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE \
    AWS_ACCESS_KEY_ID="$(jq -r .AccessKeyId <<<"$creds")" \
    AWS_SECRET_ACCESS_KEY="$(jq -r .SecretAccessKey <<<"$creds")" \
    AWS_SESSION_TOKEN="$(jq -r .SessionToken <<<"$creds")" \
    aws sts get-scoped-credentials --region "$region" \
      --endpoint-url "https://sts.$region.amazonaws.com" --output json "$@")" \
    || die "GetScopedCredentials failed for $parent with $file"

  creds="$(jq '{Version: 1,
    AccessKeyId: .Credentials.AccessKeyId,
    SecretAccessKey: .Credentials.SecretAccessKey,
    SessionToken: .Credentials.SessionToken,
    Expiration: .Credentials.Expiration}' <<<"$out")"
done <<EOF
$policies
EOF

printf '%s\n' "$creds"
