#!/usr/bin/env bash
# credential_process that assumes a profile's role with an STS AssumeRole
# session policy. It makes the same AssumeRole as the parent profile, from the
# parent's source_profile, so the role's existing trust policy is enough; only
# the permissions shrink, to the intersection of the role and the --policy.
# Several --policy flags chain one more AssumeRole per extra policy, which needs
# the role to trust itself. Sessions last the role's default (1h) or --duration.
#
#   credential_process=aws-scoped-credentials --profile cnops-dev-developer --policy readonly --description aws-mcp-readonly
#
# --policy takes a path or a name in ~/.aws/policies (readonly -> readonly.json).
# The session is named <parent role_session_name>-<description> (64 characters
# at most), so CloudTrail shows whose session it is and what it was scoped for.
#
# The credentials are cached in the login keychain (service
# aws-scoped-credentials, one item per parent profile and cache key) and reused
# until 5 minutes before they expire. The key hashes the arguments, the AWS
# config file and the policy files, so editing any of them starts a new entry.
# A refresh runs under a per-key lockf lock, so concurrent callers make one
# AssumeRole between them. To drop every cached entry:
#   while security delete-generic-password -s aws-scoped-credentials >/dev/null 2>&1; do :; done
# Written for bash 3.2: credential_process may run it outside Homebrew's PATH.
set -euo pipefail

die() { echo "aws-scoped-credentials: $*" >&2; exit 1; }

orig_args=("$@")
parent="" description="" duration="" policies=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) parent="${2:?}"; shift 2 ;;
    --policy) policies="$policies${policies:+
}${2:?}"; shift 2 ;;
    --description) description="${2:?}"; shift 2 ;;
    --duration) duration="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$parent" ] || die "--profile is required"
[ -n "$policies" ] || die "at least one --policy is required"

policy_files=""
while IFS= read -r policy; do
  case "$policy" in
    */*) file="$policy" ;;
    *) file="$HOME/.aws/policies/$policy.json" ;;
  esac
  [ -r "$file" ] || die "policy not found: $file"
  policy_files="$policy_files${policy_files:+
}$file"
done <<EOF
$policies
EOF

svc=aws-scoped-credentials
min_remaining=300

cache_key() {
  {
    printf '%s\n' "$parent" "$description" "$duration" "$policies"
    cat "${AWS_CONFIG_FILE:-$HOME/.aws/config}" 2>/dev/null || true
    while IFS= read -r f; do cat "$f"; done <<EOF
$policy_files
EOF
  } | shasum -a 256 | cut -c1-16
}

# Prints the cached credentials when they have more than min_remaining seconds
# left. security prints an item as hex when it holds non-printable bytes.
cached() {
  local raw
  raw="$(security find-generic-password -s "$svc" -a "$key" -w 2>/dev/null)" || return 1
  case "$raw" in
    "{"*) ;;
    *) raw="$(printf '%s' "$raw" | xxd -r -p)" || return 1 ;;
  esac
  printf '%s' "$raw" | jq -ce --argjson min "$min_remaining" \
    'select(.Version == 1 and ((.Expiration | sub("(\\.[0-9]+)?(Z|[+-]00:?00)$"; "Z") | fromdateiso8601) - now > $min))' \
    2>/dev/null
}

key="$parent-$(cache_key)"
if out="$(cached)"; then printf '%s\n' "$out"; exit 0; fi

if [ -z "${AWS_SCOPED_CREDENTIALS_LOCKED:-}" ] && [ -x /usr/bin/lockf ]; then
  lockdir="${XDG_CACHE_HOME:-$HOME/.cache}/aws-scoped-credentials"
  mkdir -p "$lockdir"
  # Exit 75 from lockf means another caller held the lock for 120 s, which
  # only happens while it waits on an MFA prompt.
  AWS_SCOPED_CREDENTIALS_LOCKED=1 exec /usr/bin/lockf -k -t 120 "$lockdir/$key.lock" "$0" "${orig_args[@]}"
fi
unset AWS_SCOPED_CREDENTIALS_LOCKED
if out="$(cached)"; then printf '%s\n' "$out"; exit 0; fi

role_arn="$(aws configure get role_arn --profile "$parent" || true)"
[ -n "$role_arn" ] || die "profile $parent has no role_arn to assume"
source="$(aws configure get source_profile --profile "$parent" || true)"
[ -n "$source" ] || die "profile $parent has no source_profile to assume the role from"
region="$(aws configure get region --profile "$parent" || true)"
region="${region:-${AWS_REGION:-eu-west-1}}"
base_name="$(aws configure get role_session_name --profile "$parent" || true)"
session_name="${base_name:-$parent}${description:+-$description}"
session_name="$(printf '%s' "$session_name" | tr -c 'A-Za-z0-9+=,.@_-' '-' | cut -c1-64)"

creds="$(aws configure export-credentials --profile "$source" --format process)" \
  || die "could not resolve credentials for profile $source"

while IFS= read -r file; do
  doc="$(jq -c . "$file")" || die "policy is not valid JSON: $file"
  [ "${#doc}" -le 2048 ] || die "policy is ${#doc} characters minified, over the 2048 limit: $file"

  set -- --role-arn "$role_arn" --role-session-name "$session_name" --policy "$doc"
  [ -z "$duration" ] || set -- "$@" --duration-seconds "$duration"

  # Env credentials only: a profile in the environment must not win over them.
  out="$(env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE \
    AWS_ACCESS_KEY_ID="$(jq -r .AccessKeyId <<<"$creds")" \
    AWS_SECRET_ACCESS_KEY="$(jq -r .SecretAccessKey <<<"$creds")" \
    AWS_SESSION_TOKEN="$(jq -r .SessionToken <<<"$creds")" \
    aws sts assume-role --region "$region" \
      --endpoint-url "https://sts.$region.amazonaws.com" --output json "$@")" \
    || die "AssumeRole of $role_arn failed for $parent with $file"

  creds="$(jq -c '{Version: 1,
    AccessKeyId: .Credentials.AccessKeyId,
    SecretAccessKey: .Credentials.SecretAccessKey,
    SessionToken: .Credentials.SessionToken,
    Expiration: .Credentials.Expiration}' <<<"$out")"
done <<EOF
$policy_files
EOF

# Through security's stdin, hex-encoded, so the secret never shows in argv.
printf 'add-generic-password -U -s %s -a %s -X %s\n' "$svc" "$key" \
  "$(printf '%s' "$creds" | xxd -p | tr -d '\n')" | security -i >/dev/null 2>&1 || true
cached >/dev/null || echo "aws-scoped-credentials: could not cache the credentials in the keychain" >&2

printf '%s\n' "$creds"
