#!/usr/bin/env bash
# Sign the unsigned commits between a base and HEAD.
#
# With no base it fetches every remote and uses the default branch of
# `upstream` (of `origin` when there is no `upstream`), so a fork's PR branch is
# measured against the repository the PR goes to, not against its own stale
# copy on the fork. A PR whose base is not the default branch passes it:
# `resign-commits upstream/release-1.2`.
#
# It refuses a range that holds another author's commits or more than
# 30 commits unless given --yes: either means the base is wrong, and
# signing would rewrite commits that are already on the base branch.
#
# A script rather than a fish function so it also runs from Claude Code's `!`
# prompt, which uses bash. Kept to bash 3.2 for machines without Homebrew bash.
set -euo pipefail

max_commits=30

usage() {
  echo "usage: resign-commits [--yes] [base]   # base defaults to upstream's (else origin's) default branch" >&2
  exit 2
}

yes=0
base=""
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage ;;
    -y | --yes) yes=1 ;;
    -*) usage ;;
    *) [ -z "$base" ] || usage; base=$arg ;;
  esac
done

git fetch --all --quiet

if [ -z "$base" ]; then
  if git remote get-url upstream >/dev/null 2>&1; then
    remote=upstream
  elif git remote get-url origin >/dev/null 2>&1; then
    remote=origin
  else
    echo "resign-commits: no upstream or origin remote; pass a base commit" >&2
    exit 2
  fi
  if ! base=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD"); then
    git remote set-head "$remote" --auto >/dev/null
    base=$(git symbolic-ref --short "refs/remotes/$remote/HEAD")
  fi
fi
git rev-parse --verify --quiet "$base^{commit}" >/dev/null || {
  echo "resign-commits: $base is not a commit" >&2
  exit 2
}

count=$(git rev-list --count "$base..HEAD")
me=$(git config user.email || true)
others=$(git log --format='%ae' "$base..HEAD" | grep -vxF -- "$me" | sort -u || true)
echo "resign-commits: base $base, $count commits in $base..HEAD"
if [ "$yes" -eq 0 ] && { [ "$count" -gt "$max_commits" ] || [ -n "$others" ]; }; then
  [ "$count" -le "$max_commits" ] || echo "  more than $max_commits commits" >&2
  [ -z "$others" ] || echo "  commits by others: $(echo $others)" >&2
  echo "resign-commits: refusing; check the base, or pass --yes" >&2
  exit 1
fi

# %G? needs gpg.ssh.allowedSignersFile to verify and reports N without it,
# so look for the signature header instead of verifying it.
unsigned=()
for c in $(git rev-list --reverse "$base..HEAD"); do
  git cat-file commit "$c" | grep -q '^gpgsig' || unsigned+=("$c")
done

if [ ${#unsigned[@]} -eq 0 ]; then
  echo "resign-commits: every commit in $base..HEAD is signed"
  exit 0
fi

# Commits before the oldest unsigned one keep their hashes; everything after
# it is rewritten anyway once its parent changes, so all of it gets signed.
oldest=${unsigned[0]}
total=$(git rev-list --count "$oldest^..HEAD" 2>/dev/null || git rev-list --count HEAD)
echo "resign-commits: ${#unsigned[@]} unsigned, signing $total from $(git rev-parse --short "$oldest")"

if [ "$oldest" = "$(git rev-parse HEAD)" ]; then
  git commit --amend --no-edit --no-verify --gpg-sign
elif git rev-parse -q --verify "$oldest^" >/dev/null; then
  git rebase --gpg-sign --force-rebase --rebase-merges --autostash "$oldest^"
else
  git rebase --gpg-sign --force-rebase --rebase-merges --autostash --root
fi
