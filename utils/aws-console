#!/usr/bin/env bash
# Open an AWS console URL in firefox-container under the given profile,
# using `aws-vault login` to mint a federated sign-in URL.
#
# Usage:
#   aws-console [--no-signin] <profile> [<service>|<url>]
#
# --no-signin: skip aws-vault login and open the URL directly in the
#   container. Use when you know the container already has a valid AWS
#   session, to avoid signing out other tabs in the same container.
#
# If the second positional argument starts with http(s):// it is treated
# as a destination URL (spliced into aws-vault's sign-in URL via
# --path/--region in the normal flow, passed through unchanged with
# --no-signin). Otherwise it's passed to `aws-vault login --path`.
# Omit to open the plain console home.
set -euo pipefail

# Normally invoked via the `console` fish function, which inherits the
# interactive shell's PATH. But the script may also run with a minimal
# PATH (Alfred, cron, a raw `bash` shell), so prepend locations for mise
# shims (aws-vault, aws, python3, gum) and user-local bins (firefox-container).
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Likewise, outside the interactive shell AWS_VAULT_KEYCHAIN_NAME is unset.
# Without it aws-vault uses the default `aws-vault` keychain and can't see
# the MFA'd capra-auth session cached in the `login` keychain, so it would
# prompt for MFA every time. Pin the keychain to match the interactive shell.
export AWS_VAULT_KEYCHAIN_NAME="login"

# Run "$@", showing a gum spinner for its duration, and print what it wrote
# to stdout. `gum spin` swallows the wrapped command's stdout itself (that's
# how it keeps the spinner clean), so the command is redirected to a temp
# file instead and that file is what we emit — keeps `$(spin ... )` usable
# as a normal command-substitution from the call site.
spin() {
  local title="$1"
  shift
  local out
  out="$(mktemp)"
  gum spin --spinner dot --title "$title" \
    -- env AWS_CONSOLE_SPIN_OUT="$out" bash -c '"$@" > "$AWS_CONSOLE_SPIN_OUT"' _ "$@"
  cat "$out"
  rm -f "$out"
}

no_signin=0
if [[ "${1:-}" == "--no-signin" ]]; then
  no_signin=1
  shift
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: $(basename "$0") [--no-signin] <profile> [<service>|<url>]" >&2
  exit 1
fi

profile="$1"
destination="${2:-}"

# Read directly off the config file instead of shelling out to `aws
# configure get` — it's a single local INI key, no need to pay for a full
# AWS CLI process start just to read it.
color="$(awk -v want="[profile $profile]" -F'=' '
  /^\[/ { insec = ($0 == want); next }
  insec && $1 ~ /^[ \t]*color[ \t]*$/ { v=$2; gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }
' "${AWS_CONFIG_FILE:-$HOME/.aws/config}")"

# aws-vault login needs mfa_serial to do MFA-gated AssumeRole on the
# target role. We keep mfa_serial out of the target profile so
# `aws --profile X ...` doesn't trigger its own MFA prompt. MFA token is
# cached by aws-vault session elsewhere, so no --mfa-token injection here.
export AWS_MFA_SERIAL="arn:aws:iam::259731000386:mfa/jstr"

if [[ $no_signin -eq 1 ]]; then
  if [[ -z "$destination" ]]; then
    login_url="https://console.aws.amazon.com/"
  elif [[ "$destination" =~ ^https?:// ]]; then
    login_url="$destination"
  else
    login_url="https://console.aws.amazon.com/${destination}/home"
  fi
elif [[ "$destination" =~ ^https?:// ]]; then
  # aws-vault login doesn't accept a full URL as Destination; mint a
  # generic sign-in URL then splice the original URL in via Python.
  signin="$(spin "Signing in to '$profile'…" aws-vault login --stdout "$profile")"
  encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$destination")"
  login_url="$(printf '%s' "$signin" | python3 -c '
import re, sys
signin = sys.stdin.read()
encoded = sys.argv[1]
sys.stdout.write(re.sub(r"Destination=[^&]+", "Destination=" + encoded, signin, count=1))
' "$encoded")"
elif [[ -n "$destination" ]]; then
  # Service name, e.g. "cloudformation" or "ec2/v2". aws-vault's --path
  # becomes the Destination path directly, so append /home if the caller
  # didn't already include a sub-path, to match the canonical AWS
  # console URL shape (otherwise the console shows a 404).
  path="${destination#/}"
  if [[ "$path" != */* ]]; then
    path="${path}/home"
  fi
  login_url="$(spin "Signing in to '$profile'…" aws-vault login --stdout --path "$path" "$profile")"
else
  login_url="$(spin "Signing in to '$profile'…" aws-vault login --stdout "$profile")"
fi

args=(firefox-container)
if [[ -n "$color" ]]; then
  args+=("--${color}")
fi
args+=(--name "$profile" "$login_url")

gum style --foreground 212 "Opening browser for '$profile'…" >&2
exec "${args[@]}"
