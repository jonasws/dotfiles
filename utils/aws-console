#!/usr/bin/env bash
# Open an AWS console page for a profile in a Firefox container, through Granted.
#
# Usage:
#   aws-console [--no-signin] <profile> [<service>|<url>]
#
# <service> is a console path such as "cloudformation" or "ec2/v2" (/home is
# appended when it has no sub-path); a http(s):// argument is used as the
# destination unchanged. Omit it to open the console home.
#
# --no-signin: skip the federated sign-in and open the URL directly in the
#   container. Use when you know the container already has a valid AWS session,
#   to avoid signing out other tabs in the same container.
#
# How it fits together:
#   1. `aws configure export-credentials` resolves the profile through the
#      normal CLI chain (source_profile -> capra-auth's credential_process), so
#      the MFA'd session is reused and no `aws-vault exec` is involved.
#   2. `granted console --url --firefox` turns those credentials into a
#      federated sign-in URL wrapped in an ext+granted-containers: URL.
#   3. `open -a Firefox` hands it to the Granted Firefox add-on, which opens it
#      in a container named after the profile.
# Needs the Granted add-on in Firefox:
#   https://addons.mozilla.org/firefox/addon/granted/
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") [--no-signin] <profile> [<service>|<url>]" >&2
  exit 1
}

no_signin=0
if [[ "${1:-}" == "--no-signin" ]]; then
  no_signin=1
  shift
fi
[[ $# -ge 1 ]] || usage

profile="$1"
destination="${2:-}"

# Read a key straight off the config file instead of shelling out to
# `aws configure get`: it's a single local INI key, no need to pay for a full
# AWS CLI process start just to read it.
profile_value() {
  awk -v want="[profile $profile]" -v key="$1" -F'=' '
    /^\[/ { insec = ($0 == want); next }
    insec && $1 ~ "^[ \t]*" key "[ \t]*$" { v=$2; gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }
  ' "${AWS_CONFIG_FILE:-$HOME/.aws/config}"
}

color="$(profile_value color)"
region="$(profile_value region)"

# Where to land. Regional host plus ?region=, the same shape `aws-vault login`
# produced, so the console opens in the profile's region.
if [[ "$destination" =~ ^https?:// ]]; then
  url="$destination"
else
  host="console.aws.amazon.com"
  query=""
  if [[ -n "$region" ]]; then
    host="$region.$host"
    query="?region=$region"
  fi
  if [[ -z "$destination" ]]; then
    path="console/home"
  else
    path="${destination#/}"
    [[ "$path" == */* ]] || path="$path/home"
  fi
  url="https://$host/$path$query"
fi

if [[ $no_signin -eq 1 ]]; then
  args=(firefox-container)
  [[ -n "$color" ]] && args+=("--$color")
  exec "${args[@]}" --name "$profile" "$url"
fi

creds="$(aws configure export-credentials --profile "$profile" --format env-no-export)"

granted_args=(console --url --firefox --container-name "$profile" --destination "$url")
[[ -n "$color" ]] && granted_args+=(--color "$color")
[[ -n "$region" ]] && granted_args+=(--region "$region")

# Export inside a subshell so the credentials reach granted without ever being
# on a command line (visible in `ps`) or in this shell's environment.
login_url="$(
  while IFS= read -r line; do
    export "$line"
  done <<<"$creds"
  granted "${granted_args[@]}"
)"

echo "Opening console for '$profile'…" >&2
# Go through LaunchServices: a Firefox exec'd directly from a Rex pane can't
# reach the running instance and starts a broken second one.
exec open -a "${FIREFOX_APP:-Firefox}" "$login_url"
