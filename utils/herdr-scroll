#!/usr/bin/env python3
"""Scroll a Herdr pane's scrollback from a keybinding.

Herdr 0.9.0 has no [keys] action for scrolling: the wheel and the scrollbar are
the only built-in ways to move a pane's viewport. The socket API does expose an
absolute `pane.scroll`, so a `type = "shell"` keybinding can drive it.

Usage: herdr-scroll up|down|top|bottom [lines|half|page]
"""

import json
import os
import socket
import sys


def call(method, params):
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(os.environ["HERDR_SOCKET_PATH"])
    conn = sock.makefile("rwb")
    conn.write((json.dumps({"id": "scroll", "method": method, "params": params}) + "\n").encode())
    conn.flush()
    response = json.loads(conn.readline())
    sock.close()
    if "error" in response:
        sys.exit(f"herdr-scroll: {response['error']}")
    return response["result"]


def main():
    direction = sys.argv[1] if len(sys.argv) > 1 else "up"
    amount = sys.argv[2] if len(sys.argv) > 2 else "half"

    pane_id = os.environ.get("HERDR_ACTIVE_PANE_ID") or os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        sys.exit("herdr-scroll: no pane id in environment")

    scroll = call("pane.get", {"pane_id": pane_id})["pane"]["scroll"]
    rows = scroll["viewport_rows"]
    step = {"half": max(1, rows // 2), "page": max(1, rows - 2)}.get(amount) or int(amount)

    if direction == "up":
        offset = scroll["offset_from_bottom"] + step
    elif direction == "down":
        offset = scroll["offset_from_bottom"] - step
    elif direction == "top":
        offset = scroll["max_offset_from_bottom"]
    elif direction == "bottom":
        offset = 0
    else:
        sys.exit("herdr-scroll: direction must be up, down, top, or bottom")

    offset = max(0, min(offset, scroll["max_offset_from_bottom"]))
    call("pane.scroll", {"pane_id": pane_id, "offset_from_bottom": offset})


if __name__ == "__main__":
    main()
