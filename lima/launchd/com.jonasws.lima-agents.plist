<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the agents' Docker VM (lima/agents.yaml) at login, so Docker works in
     nono from the first agent on. Linked into ~/Library/LaunchAgents by the
     lima-launchd dotfile group; load it with
     `mise -C ~/dotfiles run sync:lima-agents`. limactl start returns once the VM
     is up and the VM keeps running on its own, so this runs once per login.
     launchd expands no ~ or $HOME, hence the absolute paths. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jonasws.lima-agents</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/limactl</string>
		<string>start</string>
		<string>--tty=false</string>
		<string>agents</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/Users/jonasws</string>
	<key>StandardOutPath</key>
	<string>/Users/jonasws/.local/state/lima-agents/start.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jonasws/.local/state/lima-agents/start.log</string>
</dict>
</plist>
