#!/bin/sh
# Maven, run under fnox so it gets the credentials ~/.m2/settings.xml expects.
#
# LIFLIG_GITHUB_PAT and NEXUS_PASSWORD are env = "exec" in fnox: absent from the
# shell, so they reach Maven only through this wrapper and no other process
# inherits them. Claude Code's Bash tool runs sh, not fish, so this has to be a
# script on PATH rather than a shell function.
#
# On PATH via `_.path` in ~/.config/mise/config.toml, which mise orders ahead of
# the maven tool directory. `mise which` resolves tools, not PATH, so asking it
# for mvn returns the real binary and not this script.

set -e

real="$(mise which mvn 2>/dev/null || true)"
if [ -z "$real" ]; then
  echo "mvn: mise provisions no maven for $PWD" >&2
  exit 127
fi

# Claude Code's sandbox cannot reach the 1Password desktop app, so fnox resolves
# nothing there and `fnox exec` fails outright. Offline Maven never authenticates
# against maven.pkg.github.com or vy-nexus, so it needs no credentials at all and
# the wrapper gets out of the way. The sandbox is identifiable by $TMPDIR, which
# it points at /tmp/claude-<uid>.
#
# The Kotlin compile daemon is detached and survives between builds, which makes
# it the wrong process to hold the project's files. Under Claude Code's sandbox
# it cannot write target/ at all, because writes are granted relative to each
# process's cwd and the daemon's differs, so compilation dies on "Permission
# denied" or "Could not create directory". Compiling in-process instead, always,
# keeps one behaviour everywhere. The flag lives here and not in a pom or
# .mvn/maven.config so that CI keeps its warm daemon.
set -- -Dkotlin.compiler.daemon=false "$@"

# Maven Resolver 2 (Maven 3.10+) asks every remote repository for a
# .meta/prefixes.txt to skip lookups it knows will miss. GitHub Packages serves
# none: the capralifecycle/* wildcard URL answers 422, and Flyway's own POM
# declares a GitHub Packages repository we hold no credentials for, which answers
# 401. Both only produce a warning on every build, so stop asking those two.
set -- \
  -Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.github=false \
  -Daether.remoteRepositoryFilter.prefixes.resolvePrefixFiles.flyway-community-db-support=false \
  "$@"

# Transfer progress is worth watching live and is pure noise in a log file that
# gets read afterwards, and Maven offers no way to switch it back on once -ntp
# is passed. Key it off the terminal instead of deciding once for every build.
[ -t 1 ] || set -- -ntp "$@"

# Maven's own JVM. A full `clean verify` with the Kotlin compiler in-process
# peaks at 918M of heap and never reaches a full GC, so 2g is better than double
# the headroom it needs; the old 8g was reserving memory nothing ever touched.
# This used to live in ~/.mavenrc, which only the mvn shell script reads and
# which Maven 4 drops altogether. Here $TMPDIR expands when mvn runs rather than
# when the shell starts, which matters because Claude Code's sandbox moves it.
# Assigned only when unset, so a one-off MAVEN_OPTS on the command line wins.
MAVEN_OPTS="${MAVEN_OPTS:-\
-Xms512m -Xmx2g \
-XX:+ExitOnOutOfMemoryError \
--enable-native-access=ALL-UNNAMED \
-Djava.io.tmpdir=${TMPDIR:-/tmp} \
-Daether.enhancedLocalRepository.trackingMode=local \
-Dorg.slf4j.simpleLogger.showDateTime=true \
-Dorg.slf4j.simpleLogger.dateTimeFormat=HH:mm:ss}"

# Behind a TLS-intercepting HTTPS proxy, such as nono's credential proxy, the
# JVM needs the proxy in Maven's settings and the proxy's CA in its truststore:
# it reads neither HTTPS_PROXY nor SSL_CERT_FILE. nono writes its session CA last
# into the bundle SSL_CERT_FILE names, after the system roots, so that one
# certificate joins the JDK's own roots in a per-session PKCS12 truststore. The
# proxy goes into a generated global settings file, so ~/.m2/settings.xml and
# the repository URLs in the POMs stay exactly as they are outside the sandbox.
if [ -n "${HTTPS_PROXY:-}" ] && [ -n "${SSL_CERT_FILE:-}" ] && [ -r "$SSL_CERT_FILE" ]; then
  proxy_dir="${TMPDIR:-/tmp}/mvn-proxy-$(id -u)"
  mkdir -p "$proxy_dir" && chmod 700 "$proxy_dir"

  rest="${HTTPS_PROXY#*://}"
  rest="${rest%%/*}"
  proxy_user="" proxy_pass=""
  case "$rest" in
    *@*)
      auth="${rest%%@*}"
      rest="${rest#*@}"
      proxy_user="${auth%%:*}"
      proxy_pass="${auth#*:}"
      ;;
  esac
  proxy_settings="$proxy_dir/proxy-settings.xml"
  cat >"$proxy_settings" <<EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <proxies>
    <proxy>
      <id>session-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>${rest%:*}</host>
      <port>${rest##*:}</port>
      <username>${proxy_user}</username>
      <password>${proxy_pass}</password>
      <nonProxyHosts>localhost|127.0.0.1</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
EOF
  chmod 600 "$proxy_settings"
  set -- --global-settings "$proxy_settings" "$@"

  java_home="$(mise where java 2>/dev/null || true)"
  truststore="$proxy_dir/truststore-$(cksum <"$SSL_CERT_FILE" | cut -d' ' -f1).p12"
  if [ ! -s "$truststore" ] && [ -n "$java_home" ] && [ -x "$java_home/bin/keytool" ]; then
    keytool="$java_home/bin/keytool"
    awk '/-----BEGIN CERTIFICATE-----/ { cert = "" }
         { cert = cert $0 "\n" }
         /-----END CERTIFICATE-----/ { last = cert }
         END { printf "%s", last }' "$SSL_CERT_FILE" >"$proxy_dir/session-ca.pem"
    if ! "$keytool" -printcert -file "$proxy_dir/session-ca.pem" 2>/dev/null | grep -q 'Owner:.*nono'; then
      echo "mvn: the last certificate in $SSL_CERT_FILE is not a nono CA; trusting it anyway" >&2
    fi
    rm -f "$truststore.tmp"
    if "$keytool" -importkeystore -noprompt \
         -srckeystore "$java_home/lib/security/cacerts" -srcstorepass changeit \
         -destkeystore "$truststore.tmp" -deststoretype PKCS12 -deststorepass changeit >/dev/null 2>&1 &&
       "$keytool" -importcert -noprompt -alias proxy-session-ca -file "$proxy_dir/session-ca.pem" \
         -keystore "$truststore.tmp" -storepass changeit >/dev/null 2>&1; then
      mv "$truststore.tmp" "$truststore"
    else
      rm -f "$truststore.tmp"
    fi
  fi
  if [ -s "$truststore" ]; then
    MAVEN_OPTS="$MAVEN_OPTS -Djavax.net.ssl.trustStore=$truststore -Djavax.net.ssl.trustStorePassword=changeit -Djavax.net.ssl.trustStoreType=PKCS12"
  else
    echo "mvn: could not build a truststore with the proxy's CA (java: '${java_home:-not found}'); intercepted hosts will fail TLS" >&2
  fi
fi
export MAVEN_OPTS

case "$TMPDIR" in
  /tmp/claude-* | /private/tmp/claude-*)
    echo "mvn: sandboxed, running --offline against ~/.m2/repository" >&2
    exec "$real" --offline "$@"
    ;;
esac

# Already inside a fnox exec: the outer invocation merged the top-level secrets
# (that is what --no-defaults turns off), so the two credentials
# ~/.m2/settings.xml reads are present and a second fnox would only re-resolve
# what is already here. Under `fnox -P staging exec -- mvn ...` that is the
# common case, and skipping the inner exec keeps the process tree flat and the
# outer profile's lease credentials untouched.
if [ -n "${LIFLIG_GITHUB_PAT:-}" ] && [ -n "${NEXUS_PASSWORD:-}" ]; then
  exec "$real" "$@"
fi

exec fnox exec -- "$real" "$@"
