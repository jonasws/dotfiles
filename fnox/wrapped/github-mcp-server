#!/bin/sh
# github-mcp-server as Claude Code starts it (see ~/.claude.json), deliberately weak:
# it gets MISE_GITHUB_TOKEN, a fine-grained token with public-repo read and nothing
# else, and runs with --read-only so no write tool is even registered. Full access
# stays with the gh wrapper, which agents cannot run. The token is exported to this
# one process only; fnox-secret explains how all its callers share one Touch ID per
# cold start.

set -e

real="$(mise which github-mcp-server 2>/dev/null || true)"
if [ -z "$real" ]; then
  echo "github-mcp-server: mise provisions no github-mcp-server for $PWD" >&2
  exit 127
fi

GITHUB_PERSONAL_ACCESS_TOKEN="$("$(dirname "$0")/fnox-secret" MISE_GITHUB_TOKEN)"
export GITHUB_PERSONAL_ACCESS_TOKEN

exec "$real" "$@" --read-only
