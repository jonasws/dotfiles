#!/bin/sh
# Prints one top-level fnox secret, for consumers that fetch their own value:
# mise's credential_command and the MCP server wrappers next to this script.
#
# Every caller goes through the same request so that the first one after a cold
# start pays the single Touch ID and the rest are served from the daemon cache:
#
# - `-c` names the global config explicitly, which stops fnox walking up from the
#   caller's directory. The daemon fingerprints every config file it loads, so a
#   ~/CX/fnox.toml picked up on the way would make its own cold cache per tree.
# - `export --all` resolves every top-level secret in one batch, and so one
#   Secure Enclave decrypt of the shared sync blob, where `fnox get` resolves one.
#   The daemon keys its cache by command, so `get` and `export` never share hits.
# - `--non-interactive` makes the daemon resolve under its request lock instead of
#   handing the work back to the caller. Claude Code starts its MCP servers in
#   parallel; serialised, the second waits for the first and hits the cache.

set -e

case "$1" in
  '' | [0-9]* | *[!A-Za-z0-9_]*)
    echo "usage: fnox-secret KEY" >&2
    exit 2
    ;;
esac

exports="$(fnox -c "$HOME/.config/fnox/config.toml" --non-interactive export --all -f shell)"
eval "$exports"
eval "value=\${$1:-}"
if [ -z "$value" ]; then
  echo "fnox-secret: $1 did not resolve" >&2
  exit 1
fi
printf '%s\n' "$value"
