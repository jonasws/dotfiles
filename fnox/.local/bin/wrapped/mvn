#!/bin/sh
# Maven, run under fnox so it gets the credentials ~/.m2/settings.xml expects.
#
# LIFLIG_GITHUB_PAT and NEXUS_PASSWORD are env = "exec" in fnox: absent from the
# shell, so they reach Maven only through this wrapper and no other process
# inherits them. Claude Code's Bash tool runs sh, not fish, so this has to be a
# script on PATH rather than a shell function.
#
# On PATH via `_.path` in ~/.config/mise/config.toml, which mise orders ahead of
# the maven tool directory. `mise which` resolves tools, not PATH, so asking it
# for mvn returns the real binary and not this script.

set -e

real="$(mise which mvn 2>/dev/null || true)"
if [ -z "$real" ]; then
  echo "mvn: mise provisions no maven for $PWD" >&2
  exit 127
fi

# fnox derives its daemon socket path from $TMPDIR, and Claude Code's sandbox
# rewrites $TMPDIR to a per-session directory. The host daemon is therefore
# invisible there, and the daemon fnox tries to start in its place cannot bind a
# socket under Seatbelt, so `fnox exec` dies with "fnox daemon did not become
# ready". Resolving secrets in-process is ~4.5s slower but always works.
# `fnox daemon status` only probes; it never starts a daemon.
no_daemon=
if fnox daemon status 2>&1 | grep -q "not running"; then
  no_daemon=--no-daemon
fi

exec fnox exec $no_daemon -- "$real" "$@"
