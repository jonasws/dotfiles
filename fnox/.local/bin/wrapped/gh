#!/bin/sh
# GitHub CLI, run under fnox so it gets a token without one sitting in the shell.
#
# GH_TOKEN is env = "exec" in fnox: absent from the shell, so it reaches gh only
# through this wrapper and no other process inherits it. Claude Code's Bash tool
# runs sh, not fish, so this has to be a script on PATH rather than a shell
# function.
#
# On PATH via `_.path` in ~/.config/mise/config.toml, which mise orders ahead of
# the github-cli tool directory. `mise which` resolves tools, not PATH, so asking
# it for gh returns the real binary and not this script.

set -e

real="$(mise which gh 2>/dev/null || true)"
if [ -z "$real" ]; then
  echo "gh: mise provisions no github-cli for $PWD" >&2
  exit 127
fi

exec fnox exec -- "$real" "$@"
