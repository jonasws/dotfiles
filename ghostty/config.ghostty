# Ghostty, set up to stand in for WezTerm (wezterm/dot-wezterm.lua) as the host
# for tuios and herdr. Linked to ~/.config/ghostty by the ghostty dotfile group
# in mise.toml. Check with `ghostty +validate-config`; super+shift+r reloads.

# ── Appearance ──────────────────────────────────────────────────────────────

# Always dark, whatever macOS is set to: no light:/dark: pair. Ghostty's
# bundled Mocha over catppuccin/ghostty's file in themes/: its brights are
# lighter tints, so bold and bright text stand out, and it selects in
# rosewater. tuios (themes/mocha-ghostty.json) and Claude Code follow it.
theme = Catppuccin Mocha

# As in WezTerm: text from plain JetBrains Mono, icon and powerline glyphs from
# the Nerd Font Mono build, which keeps every glyph inside one cell. Ghostty
# also has Nerd Font symbols built in, after these.
font-family = "JetBrains Mono"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 18
# Ligatures (calt) stay on, as Ghostty's default. On top: a zero with a slash,
# and the single-storey g.
font-feature = zero
font-feature = cv03
# No adjust-cell-height: WezTerm runs line_height = 1.0.
# JetBrains Mono sits a pixel low in its cell on the 1x office ultrawide, so
# powerline pills show more room above the text than below. One pixel up
# centres it there and is barely visible on the Retina panel.
adjust-font-baseline = 1

# Read theme colours as Display P3, more saturated than sRGB, which looked
# washed out on the office ultrawide. Its panel covers about 85-92% of P3, so
# the XDR panel still shows more of it.
window-colorspace = display-p3
# Lift text that sits too close to its background. Mocha's ANSI 8 (#585b70),
# the dim text in Claude Code's dark-ansi diffs, is 2.46:1 on base; 3 is the
# docs' mark for text that is hard to read.
minimum-contrast = 3
# Faint text (SGR 2) at half opacity is about 3.9:1 on base; Claude Code draws
# its vim "-- INSERT --" that way, with no theme token to change it. 0.75 gives
# about 7:1.
faint-opacity = 0.75

background-opacity = 0.9
background-blur-radius = 10
# The padding takes the colour of the cells at the edge, so tuios's rail and
# dock run to the window's border with no seam.
window-padding-color = extend

# WezTerm's window_decorations = 'RESIZE': no title bar. Native tabs still
# appear once a window has more than one.
macos-titlebar-style = hidden
macos-non-native-fullscreen = false

# ── Terminal ────────────────────────────────────────────────────────────────

scrollback-limit = 100000
copy-on-select = clipboard
shell-integration = fish

# Reopen windows where they were. tuios restores the sessions inside them.
window-save-state = always
# Homebrew installs and updates Ghostty (homebrew/Brewfile), so its own
# updater stays off.
auto-update = off

# Both Option keys send Alt, as WezTerm's send_composed_key_when_*_alt_is_pressed
# = false do, so Alt chords reach nvim, tuios and herdr.
macos-option-as-alt = true

# ── Keys ────────────────────────────────────────────────────────────────────
# Ctrl+hjkl and Ctrl+Shift+hjkl are left to the pane: tuios and herdr move and
# resize their panes with them (herdr-splits), and Neovim its windows. Ghostty
# cannot see what runs in a split, so it takes no chord they use; its own
# splits move on Cmd+L then hjkl, WezTerm's leader.

keybind = super+shift+r=reload_config
keybind = alt+enter=unbind

# Shift+Enter is Alt+Enter (ESC CR), a newline in Claude Code. A bare LF is
# ctrl+j, which tuios and herdr bind to pane movement.
keybind = shift+enter=text:\x1b\r

# Option+Left/Right: Ghostty's defaults rewrite them to ESC b / ESC f before
# encoding, so neither tuios nor the shell would see the arrow.
keybind = alt+left=unbind
keybind = alt+right=unbind

# Cmd chords for tuios. Unbound here, Ghostty sends them to tuios under the
# kitty keyboard protocol, and tuios/config.toml binds them: Cmd+K the pane
# navigator, Cmd+T a new workspace, Cmd+W close the pane, Cmd+1..9 a
# workspace. Digits need both forms unbound. Ghostty's own windows and tabs
# keep Cmd+N and Cmd+Shift+W.
keybind = super+k=unbind
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+1=unbind
keybind = super+digit_1=unbind
keybind = super+2=unbind
keybind = super+digit_2=unbind
keybind = super+3=unbind
keybind = super+digit_3=unbind
keybind = super+4=unbind
keybind = super+digit_4=unbind
keybind = super+5=unbind
keybind = super+digit_5=unbind
keybind = super+6=unbind
keybind = super+digit_6=unbind
keybind = super+7=unbind
keybind = super+digit_7=unbind
keybind = super+8=unbind
keybind = super+digit_8=unbind
keybind = super+9=unbind
keybind = super+digit_9=unbind

keybind = super+d=new_split:down
keybind = super+r=new_split:right
keybind = super+l>h=goto_split:left
keybind = super+l>j=goto_split:down
keybind = super+l>k=goto_split:up
keybind = super+l>l=goto_split:right
split-preserve-zoom = navigation

keybind = super+p=toggle_command_palette

# ── Quick Terminal ──────────────────────────────────────────────────────────
# F19 drops a Ghostty panel from the top from any app: a double tap of right
# Option on the built-in keyboard (karabiner-ts/karabiner.config.ts) or of Home
# on the Keychron (keychron/q1-max.vil, tap dance 0). It opens tuios's own
# "quick" session (fish/conf.d/55-ghostty-quick-terminal.fish) and hides again
# when it loses focus. global: needs Accessibility permission.
keybind = global:f19=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 60%
quick-terminal-space-behavior = move
