# Ghostty, set up to stand in for WezTerm (wezterm/dot-wezterm.lua) as the host
# for tuios and herdr. Linked to ~/.config/ghostty by the ghostty dotfile group
# in mise.toml. Check with `ghostty +validate-config`; super+shift+r reloads.

# ── Appearance ──────────────────────────────────────────────────────────────

theme = Catppuccin Mocha

# As in WezTerm: text from plain JetBrains Mono, icon and powerline glyphs from
# the Nerd Font Mono build, which keeps every glyph inside one cell. Ghostty
# also has Nerd Font symbols built in, after these.
font-family = "JetBrains Mono"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 18
# No adjust-cell-height: WezTerm runs line_height = 1.0.

background-opacity = 0.9
background-blur-radius = 10

# WezTerm's window_decorations = 'RESIZE': no title bar. Native tabs still
# appear once a window has more than one.
macos-titlebar-style = hidden
macos-non-native-fullscreen = false

# ── Terminal ────────────────────────────────────────────────────────────────

scrollback-limit = 100000
copy-on-select = clipboard
shell-integration = fish

# Both Option keys send Alt, as WezTerm's send_composed_key_when_*_alt_is_pressed
# = false do, so Alt chords reach nvim, tuios and herdr.
macos-option-as-alt = true

# ── Keys ────────────────────────────────────────────────────────────────────
# Ctrl+hjkl and Ctrl+Shift+hjkl are left to the pane: tuios and herdr move and
# resize their panes with them (herdr-splits), and Neovim its windows. Ghostty
# cannot see what runs in a split, so it takes no chord they use; its own
# splits move on Cmd+L then hjkl, WezTerm's leader.

keybind = super+shift+r=reload_config
keybind = alt+enter=unbind

# Shift+Enter is Alt+Enter (ESC CR), a newline in Claude Code. A bare LF is
# ctrl+j, which tuios and herdr bind to pane movement.
keybind = shift+enter=text:\x1b\r

# Cmd+K opens the pane navigator in tuios (choose_tree) and herdr: both bind
# ctrl+alt+k, sent here as CSI u as WezTerm does.
keybind = super+k=csi:107;7u

keybind = super+d=new_split:down
keybind = super+r=new_split:right
keybind = super+l>h=goto_split:left
keybind = super+l>j=goto_split:down
keybind = super+l>k=goto_split:up
keybind = super+l>l=goto_split:right
split-preserve-zoom = navigation

keybind = super+p=toggle_command_palette
