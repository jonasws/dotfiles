#!/bin/sh
# Prints one secret for the pi-agent nono profile's credential proxy.
#
# nono runs this from its supervisor, outside the sandbox, the first time a
# sandboxed pi sends a request down a credential route (credential_capture in
# nono/profiles/pi-agent.jsonc). The proxy injects the value upstream; the
# sandbox only ever holds a per-session phantom.
#
# Not fnox-secret directly: this runs with the user's full rights but in the
# environment of the shell that started pi, whose PATH can include project
# directories the sandbox may write to (mise `_.path`, node_modules/.bin), and
# fnox-secret finds fnox by name. So start again from an empty environment, a
# fixed PATH and `/` as cwd, where mise reads only the global config, and hand
# fnox-secret the fnox that config installs. TMPDIR is kept because the fnox
# daemon's socket lives under it; a different one would mean a cold daemon and
# another Touch ID.
#
# The key list is closed so the profile cannot be edited, or this script
# reused, into a general secret reader.

set -eu

case "${1:-}" in
  ANTHROPIC_API_KEY | EXA_API_KEY | MISE_GITHUB_TOKEN) ;;
  *)
    echo "pi-credential: not a pi credential: ${1:-}" >&2
    exit 2
    ;;
esac

if [ "${PI_CREDENTIAL_CLEAN:-}" != 1 ]; then
  exec /usr/bin/env -i \
    PI_CREDENTIAL_CLEAN=1 \
    HOME="$HOME" \
    USER="${USER:-}" \
    LOGNAME="${LOGNAME:-}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    PATH=/opt/homebrew/bin:/usr/bin:/bin \
    /bin/sh "$0" "$1"
fi

cd /
fnox_bin="$(mise which fnox)"
PATH="${fnox_bin%/*}:$PATH"
# fnox falls back to the 1Password CLI for a secret not yet synced into the
# age cache; age-plugin-se is already on the Homebrew path above.
if op_bin="$(mise which op 2>/dev/null)"; then
  PATH="${op_bin%/*}:$PATH"
fi
export PATH

exec "$HOME/.local/bin/wrapped/fnox-secret" "$1"
