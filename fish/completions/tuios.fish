# tuios completions: cobra's script, generated by the installed build, plus the
# arguments cobra has no completion for (window targets, plugin ids, skill
# topics), which fish would otherwise offer as filenames.
#
# Sourced rather than copied, so the commands and flags track the build on PATH.
# The generated script starts with `complete -c tuios -e`, so everything below
# has to come after it.
command -q tuios; or return
tuios completion fish | source

# Window ids of the session named by -s/--session before the cursor, else the
# session of this pane. The first eight characters of an id are a valid target.
function __tuios_windows
    set -l tokens (commandline -opc)
    set -l session
    for i in (seq (count $tokens))
        switch $tokens[$i]
            case -s --session
                set session $tokens[(math $i + 1)]
            case '--session=*'
                set session (string replace -- '--session=' '' $tokens[$i])
        end
    end
    set -l args
    test -n "$session"; and set args -s $session
    tuios list-windows $args --json 2>/dev/null \
        | jq -r '.windows[]? | "\(.window_id[0:8])\t\(.display_name // .title // "") (\(.foreground_cmd // ""))"'
end

function __tuios_plugin_ids
    tuios plugins list 2>/dev/null | string replace -ra '\e\[[0-9;]*m' '' \
        | awk 'NR > 1 {print $1}' | sort -u
end

# True after `tuios plugins <verb>` for the verbs that take a plugin id.
function __tuios_wants_plugin_id
    set -l tokens (commandline -opc)
    test (count $tokens) -eq 3; and test "$tokens[2]" = plugins
    and contains -- $tokens[3] enable disable approve build uninstall
end

# True when the first word after tuios is one of the given subcommands and no
# window has been named yet.
function __tuios_wants_window
    set -l tokens (commandline -opc)
    test (count $tokens) -eq 2; and contains -- $tokens[2] $argv
end

function __tuios_skill_topics
    tuios --skill none 2>&1 | string replace -r '.*topics are ' '' | string split ', '
end

complete -c tuios -s w -l window -x -a '(__tuios_windows)' -d 'Target window'
complete -c tuios -n '__tuios_wants_window focus-window close-window' -f -a '(__tuios_windows)'
complete -c tuios -n __tuios_wants_plugin_id -f -a '(__tuios_plugin_ids)'
complete -c tuios -l skill -x -a '(__tuios_skill_topics)' -d 'Skill topic'
