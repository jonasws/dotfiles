{
  "atuin": {
    "type": "stdio",
    "command": "$HOME/.local/share/mise/installs/atuin/latest/atuin-aarch64-apple-darwin/atuin",
    "args": ["mcp"],
    "env": {}
  },
  "aws": {
    "type": "stdio",
    "command": "uvx",
    "args": ["mcp-proxy-for-aws@1.8.0", "https://aws-mcp.eu-central-1.api.aws/mcp", "--metadata", "AWS_REGION=eu-west-1"],
    "env": {
      "AWS_MCP_PROXY_PROFILES": "cn-cx-dev-readonly cn-cx-build-readonly cn-cx-staging-readonly cn-cx-prod-readonly cn-terminal-dev-readonly cn-terminal-build-readonly cn-terminal-staging-readonly cn-terminal-prod-readonly cnops-dev-readonly cnops-build-readonly cnops-staging-readonly cnops-prod-readonly"
    }
  },
  "aws-knowledge": {
    "type": "http",
    "url": "https://knowledge-mcp.global.api.aws"
  },
  "exa": {
    "type": "stdio",
    "command": "$HOME/.local/bin/wrapped/exa-mcp-server",
    "args": [],
    "env": {
      "ENABLED_TOOLS": "web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run"
    }
  },
  "fff": {
    "type": "stdio",
    "command": "$HOME/.local/share/mise/installs/github-dmtr-kovalenko-fff/latest/fff-mcp",
    "args": ["--no-update-check"],
    "env": {}
  },
  "github": {
    "type": "stdio",
    "command": "$HOME/.local/bin/wrapped/github-mcp-server",
    "args": ["stdio"],
    "env": {}
  },
  "journey": {
    "type": "http",
    "url": "http://localhost:8765/mcp"
  },
  "ruteplan": {
    "type": "http",
    "url": "https://ruteplan-mcp.trafficinfo.vydev.io/mcp"
  },
  "semble": {
    "type": "stdio",
    "command": "uvx",
    "args": ["--from", "semble[mcp]", "semble"],
    "env": {}
  },
  "superlogical": {
    "type": "http",
    "url": "https://www.superlogical.com/rex/community-mcp"
  },
  "tuios": {
    "type": "stdio",
    "command": "$HOME/.local/bin/tuios",
    "args": ["mcp", "--write"],
    "env": {}
  }
}
