spacemacs/.spacemacs.env
doom/private.el
fish/local.fish

lazyvim/spell

zed/.*
zed/embeddings/
zed/prompts/
yazi/flavors/
yazi/plugins/
nix-darwin/result
# tv channels: upstream ones come from `tv update-channels` and stay untracked.
# Our own live in cable/mine/. Forks of upstream channels keep the upstream file
# name, which tv keys channels by, so update-channels skips them instead of a
# second copy colliding with them.
television/cable/*
!television/cable/mine/
!television/cable/aws-profiles.toml
!television/cable/channels.toml
!television/cable/git-repos.toml
!television/cable/git-worktrees.toml
!television/cable/zoxide.toml
/.tmp
/superfile/theme
/fnox/age-se.txt

karabiner-ts/node_modules/

# Generated: the theme-reload marker tuios writes, and the conf that
# herdr-splits.nvim regenerates on every setup().
tuios/.reload-themes
tuios/plugin-config/herdr-splits/

# tuios push notifications: the ntfy topic is a secret.
tuios/config.d/notify.toml
# Stamps tuios writes in its config folder to signal running clients.
tuios/.apply-config
tuios/.reload-themes
__pycache__/

# Raspberry Pi (rpi/): files tuios writes into its linked config folder, and
# what `tuios integration install rex` writes if it follows the init.lua link.
rpi/tuios/.apply-config
rpi/tuios/.reload-themes
rpi/tuios/plugins.lock
rpi/rex/tuios.lua
rpi/rex/*.tuios.bak
